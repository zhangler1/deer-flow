# 应用基础配置
DEBUG=True
APP_ENV=development
AGENT_RECURSION_LIMIT=25

# LangSmith 调试和追踪配置
# 1. 访问 https://smith.langchain.com/ 注册账号
# 2. 获取 API Key: https://smith.langchain.com/settings
# 3. 取消下面三行的注释并填入你的 API Key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=deer-flow  # 可自定义项目名称


RESEARCHER_RECURSION_LIMIT=5
# 系统背景上下文（可选）
# 为所有查询提供背景上下文，在 Prompt 模板中使用
# 示例：问题关于交通银行、技术支持场景、客服对话等
SYSTEM_CONTEXT=问题关于交通银行、技术支持场景、客服对话
LLM_NETWORK=external
# 日志级别配置
# 支持的值: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG - 显示所有详细信息（包括检索结果的标题和内容）
# INFO - 只显示摘要信息（默认）
# WARNING - 只显示警告和错误
# ELLM_LOG_DEBUG=1 
# LOG_LEVEL=DEBUG
# 日志文件路径
LOG_FILE=./logs/deer-flow.log

# 可选：设置日志级别
LOG_LEVEL=INFO
# CORS 配置 - 添加您当前使用的 IP 地址（浏览器访问地址）
# 注意：这里配置的是浏览器访问后端的源地址，不是Docker内部地址
# ALLOWED_ORIGINS=http://192.168.0.106,http://localhost,http://127.0.0.1
# MCP 和 Python REPL 配置
ENABLE_MCP_SERVER_CONFIGURATION=false
ENABLE_PYTHON_REPL=false

# 后端地址，前端浏览器访问，用backend不行,因为，前端不能够通过内部的域名解析
# NEXT_PUBLIC_API_URL=http://192.168.0.106/api
# 不写有默认配置

NEXT_PUBLIC_BASE_PATH=/deep-research-deerflow
# 搜索引擎配置
# bocomsearch: 交通银行内部知识库搜索（GUWP Token 鉴权）
BOCOM_SEARCH_API_URL=http://192.168.0.106:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do
# online_search: 互联网公开信息搜索
ONLINE_SEARCH_API_URL=http://192.168.0.106:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do

# searchknowledge_standard: EUVD 段落级标准知识检索
# 真实接口: http://euvd-chn-slb-7002.bocomm.com/EUVD.EUVD-ADAPTER.V-1.0/searchKnowledgeStandard.do
SEARCHKNOWLEDGE_API_URL=http://192.168.0.106:8010/EUVD.EUVD-ADAPTER.V-1.0/searchKnowledgeStandard.do
SEARCHKNOWLEDGE_CALLER=P2024146
SEARCHKNOWLEDGE_USER_CODE=9855835
# 空间编码列表，逗号分隔
SEARCHKNOWLEDGE_SPACE_CODES=SP0999999
# 召回参数（可选）
SEARCHKNOWLEDGE_VECTOR_TOPN=3
SEARCHKNOWLEDGE_TEXT_TOPN=0
SEARCHKNOWLEDGE_THRESHOLD=0.1

# .env 里配置
ONLINE_SEARCH_MAX_RESULTS=5
SEARCHKNOWLEDGE_MAX_RESULTS=3
# 行业研报、新闻搜索服务配置
INDUSTRY_REPORT_API_URL=http://192.168.0.106:8011/IDIS/IDIS-DATA/queryIndustryReportList.bocms
NEWS_SEARCH_API_URL=http://192.168.0.106:8012/IDIS/IDIS-DATA/queryNewsList.bocms
NEWS_DETAIL_API_URL=http://192.168.0.106:8013/IDIS/IDIS-DATA/queryNewsDetail.bocms
INDUSTRY_REPORT_NUM=2

# HTML 抽取服务配置
# 用于 DeepResearch 模式下的网页内容抽取和 Markdown 转换
# 该接口一次性完成: HTML抓取 → 内容提取 → Markdown转换
HTML_EXTRACT_API_URL=http://192.168.0.106:7986/extract_md

# Rerank API 配置
# 用于新闻搜索结果重排序
# RERANK_API_URL=http://53.192.13.31:8415/v1/rerank


# Easyparse Service URL (Markdown to Word conversion)
# Default: http://localhost:5000
EASYPARSE_SERVICE_URL=http://nginx

# ============================================================================
# LangGraph Checkpoint 配置 - PostgreSQL 持久化存储
# ============================================================================
# 启用 LangGraph checkpoint saver，支持对话历史持久化和上下文关联
LANGGRAPH_CHECKPOINT_SAVER=true

# PostgreSQL 连接字符串
# Docker 内部网络使用服务名：postgres
# 宿主机访问使用：localhost
LANGGRAPH_CHECKPOINT_DB_URL=postgresql://deerflow:deerflow_password_2025@postgres:5432/deerflow_checkpoint

# 如果从宿主机直接访问（调试用），使用下面的配置：
# LANGGRAPH_CHECKPOINT_DB_URL=postgresql://deerflow:deerflow_password_2025@localhost:5432/deerflow_checkpoint