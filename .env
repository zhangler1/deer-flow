# 应用基础配置
DEBUG=True
APP_ENV=development
AGENT_RECURSION_LIMIT=25

# LangSmith 调试和追踪配置
# 1. 访问 https://smith.langchain.com/ 注册账号
# 2. 获取 API Key: https://smith.langchain.com/settings
# 3. 取消下面三行的注释并填入你的 API Key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=deer-flow  # 可自定义项目名称

# LangFuse 配置（本地部署）
# 1. 访问 http://localhost:3001 创建账号
# 2. 在项目设置中获取 API Keys
# 3. 取消下面的注释并填入你的密钥
LANGFUSE_PUBLIC_KEY=pk-lf-56cb5dde-1382-4f44-a9b5-0bc0852dab3f
LANGFUSE_SECRET_KEY=sk-lf-42f4a005-7a85-4a43-aa85-751613904b2c
LANGFUSE_HOST=http://langfuse-server:3000 # Docker 内部访问
LANGFUSE_ENABLED=true

# 系统背景上下文（可选）
# 为所有查询提供背景上下文，在 Prompt 模板中使用
# 示例：问题关于交通银行、技术支持场景、客服对话等
SYSTEM_CONTEXT=问题关于交通银行、技术支持场景、客服对话

# 日志级别配置
# 支持的值: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG - 显示所有详细信息（包括检索结果的标题和内容）
# INFO - 只显示摘要信息（默认）
# WARNING - 只显示警告和错误
LOG_LEVEL=DEBUG
# 日志文件路径
LOG_FILE=./logs/deer-flow.log

# 可选：设置日志级别
LOG_LEVEL=INFO
# CORS 配置 - 添加您当前使用的 IP 地址（浏览器访问地址）
# 注意：这里配置的是浏览器访问后端的源地址，不是Docker内部地址
ALLOWED_ORIGINS=http://192.168.0.106,http://localhost,http://127.0.0.1
# MCP 和 Python REPL 配置
ENABLE_MCP_SERVER_CONFIGURATION=false
ENABLE_PYTHON_REPL=false

# 后端地址，前端浏览器访问，用backend不行,因为，前端不能够通过内部的域名解析
NEXT_PUBLIC_API_URL=http://192.168.0.106/api
# # 搜索引擎配置
# SEARCH_API=tavily
# TAVILY_API_KEY=your_tavily_key_here

#自定义搜索引擎配置（可选）
SEARCH_API=custom_search
CUSTOM_SEARCH_API_URL=http://192.168.0.106:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do
                    #   http://localhost:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do
CUSTOM_SEARCH_API_KEY=your_custom_search_api_key
CUSTOM_SEARCH_REPOSITORY=okic-dynamicSearch
CUSTOM_SEARCH_CHANNEL_ID=0
