# Application Settings
DEBUG=True
APP_ENV=development

# 🐛 Debug Mode - Force routing path (optional)
# Bypass smart classifier and force route to specific path
# Supported values: direct_answer, simple_search, iterative_research, deep_research
# Leave empty or comment out to use normal smart routing
# DEBUG_FORCE_ROUTING_PATH=iterative_research

# System Context (optional)
# Provides background context for all queries, used in prompt templates
# Example: SYSTEM_CONTEXT="问题关于交通银行"
SYSTEM_CONTEXT=

# docker build args
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

AGENT_RECURSION_LIMIT=30

# CORS settings
# Comma-separated list of allowed origins for CORS requests
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://example.com
ALLOWED_ORIGINS=http://localhost:3000

# Enable or disable MCP server configuration, the default is false.
# Please enable this feature before securing your front-end and back-end in a managed environment.
# Otherwise, you system could be compromised.
ENABLE_MCP_SERVER_CONFIGURATION=false

# Enable or disable PYTHON_REPL configuration, the default is false.
# Please enable this feature before securing your in a managed environment.
# Otherwise, you system could be compromised.
ENABLE_PYTHON_REPL=false

# Search Engine, Supported values: tavily (recommended), duckduckgo, brave_search, arxiv, wikipedia, custom_search
SEARCH_API=tavily
TAVILY_API_KEY=tvly-xxx
# BRAVE_SEARCH_API_KEY=xxx # Required only if SEARCH_API is brave_search
# JINA_API_KEY=jina_xxx # Optional, default is None

# Search Engine Configuration
# bocomsearch: 交通银行内部知识库搜索（GUWP Token 鉴权）
# BOCOM_SEARCH_API_URL=http://eaip-chn-slb-7006.bocomm.com/ELLM.ELLM-OFFICE.V-1.0/querySources.do
# online_search: 互联网公开信息搜索
# ONLINE_SEARCH_API_URL=https://your-search-api.com/search
# ONLINE_SEARCH_API_KEY=your_api_key

# searchknowledge_standard: EUVD 段落级标准知识检索
# SEARCHKNOWLEDGE_API_URL=http://euvd-chn-slb-7002.bocomm.com/EUVD.EUVD-ADAPTER.V-1.0/searchKnowledgeStandard.do
# SEARCHKNOWLEDGE_CALLER=P2024146
# SEARCHKNOWLEDGE_USER_CODE=9855835
# SEARCHKNOWLEDGE_SPACE_CODES=SP0999999            # 空间编码列表，逗号分隔，例如 "SP0999999,SP0000036"
# SEARCHKNOWLEDGE_VECTOR_TOPN=3                    # 向量召回TopN（默认 3）
# SEARCHKNOWLEDGE_TEXT_TOPN=0                      # 文本召回TopN（默认 0）
# SEARCHKNOWLEDGE_THRESHOLD=0.1                    # 匹配分阈值（默认 0.1）

# Industry Report, News Search API Configuration (Optional)
# INDUSTRY_REPORT_API_URL=http://192.168.150.71:8011/IDIS/IDIS-DATA/queryIndustryReportList.bocms
# NEWS_SEARCH_API_URL=http://192.168.150.71:8012/IDIS/IDIS-DATA/queryNewsList.bocms
# NEWS_DETAIL_API_URL=http://192.168.150.71:8013/IDIS/IDIS-DATA/queryNewsDetail.bocms

# Optional, RAG provider
# RAG_PROVIDER=vikingdb_knowledge_base
# VIKINGDB_KNOWLEDGE_BASE_API_URL="api-knowledgebase.mlp.cn-beijing.volces.com"
# VIKINGDB_KNOWLEDGE_BASE_API_AK="AKxxx"
# VIKINGDB_KNOWLEDGE_BASE_API_SK=""
# VIKINGDB_KNOWLEDGE_BASE_RETRIEVAL_SIZE=15

# RAG_PROVIDER=ragflow
# RAGFLOW_API_URL="http://localhost:9388"
# RAGFLOW_API_KEY="ragflow-xxx"
# RAGFLOW_RETRIEVAL_SIZE=10
# RAGFLOW_CROSS_LANGUAGES=English,Chinese,Spanish,French,German,Japanese,Korean # Optional. To use RAGFlow's cross-language search, please separate each language with a single comma


# RAG_PROVIDER: milvus  (using free milvus instance on zilliz cloud: https://docs.zilliz.com/docs/quick-start )
# RAG_PROVIDER=milvus
# MILVUS_URI=<endpoint_of_self_hosted_milvus_or_zilliz_cloud>
# MILVUS_USER=<username_of_self_hosted_milvus_or_zilliz_cloud>
# MILVUS_PASSWORD=<password_of_self_hosted_milvus_or_zilliz_cloud>
# MILVUS_COLLECTION=documents
# MILVUS_EMBEDDING_PROVIDER=openai # support openai,dashscope
# MILVUS_EMBEDDING_BASE_URL=
# MILVUS_EMBEDDING_MODEL=
# MILVUS_EMBEDDING_API_KEY=
# MILVUS_AUTO_LOAD_EXAMPLES=true

# RAG_PROVIDER: milvus  (using milvus lite on Mac or Linux)
# RAG_PROVIDER=milvus
# MILVUS_URI=./milvus_demo.db
# MILVUS_COLLECTION=documents
# MILVUS_EMBEDDING_PROVIDER=openai # support openai,dashscope
# MILVUS_EMBEDDING_BASE_URL=
# MILVUS_EMBEDDING_MODEL=
# MILVUS_EMBEDDING_API_KEY=
# MILVUS_AUTO_LOAD_EXAMPLES=true

# Optional, volcengine TTS for generating podcast
VOLCENGINE_TTS_APPID=xxx
VOLCENGINE_TTS_ACCESS_TOKEN=xxx
# VOLCENGINE_TTS_CLUSTER=volcano_tts # Optional, default is volcano_tts
# VOLCENGINE_TTS_VOICE_TYPE=BV700_V2_streaming # Optional, default is BV700_V2_streaming

# Option, for langsmith tracing and monitoring
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# LANGSMITH_API_KEY="xxx"
# LANGSMITH_PROJECT="xxx"

# Option, for langfuse tracing and monitoring
# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # Or your self-hosted URL

# [!NOTE]
# For model settings and other configurations, please refer to `docs/configuration_guide.md`

# LLM Network Switch
# - external (default): load conf.yaml, e.g. DeepSeek / OpenAI
# - internal          : load conf.internal.yaml, e.g. BOCOM ELLM (dynamic api-key)
# If set to `internal` but conf.internal.yaml is missing, the loader logs a
# warning and falls back to conf.yaml so the process still starts.
# LLM_NETWORK=external

# Option, for langgraph mongodb checkpointer
# Enable LangGraph checkpoint saver, supports MongoDB, Postgres
#LANGGRAPH_CHECKPOINT_SAVER=true
# Set the database URL for saving checkpoints
#LANGGRAPH_CHECKPOINT_DB_URL=mongodb://localhost:27017/
#LANGGRAPH_CHECKPOINT_DB_URL=postgresql://localhost:5432/postgres

# Easyparse Service URL (Markdown to Word conversion)
# Default: http://localhost:5000
EASYPARSE_SERVICE_URL=http://localhost:5000

# 文件加密服务配置（docx 加密接口）
# ENCRYPT_API_URL=http://12.244.130.39/ELLM.ELLM-OFFICE.V-1.0/pptEncryptFile.upload

# MinIO 对象存储（报告文件存储）
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=deer-flow-reports
# MINIO_SECURE=false
# MINIO_PUBLIC_URL=  # 可选，使用 nginx 代理时填写公开访问地址

# 用户认证（queryUserInfo 接口）
# USER_INFO_API_URL=http://eaip-chn-slb-7006.bocomm.com/ELLM.ELLM-OMSERVICE.V-1.0/queryUserInfo.do
# USER_INFO_CACHE_TTL=300

# 看板统计日志
# STATISTICS_LOG_DIR=logs/statistics
# STATISTICS_LOG_RETENTION_DAYS=90
