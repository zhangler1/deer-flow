# ==========================================
# MySQL Docker 环境变量配置示例
# ==========================================
# 使用方法:
#   1. 复制此文件为 .env.mysql
#   2. 修改密码和配置
#   3. 在 docker-compose 中引用: env_file: - .env.mysql
# ==========================================

# ========== MySQL 容器配置 ==========

# Root 用户密码（必需，请务必修改为强密码！）
MYSQL_ROOT_PASSWORD=7175723zl

# 默认数据库名称（容器启动时自动创建）
MYSQL_DATABASE=omservice

# 应用用户名（容器启动时自动创建）
# 注意：用户名包含特殊字符时需要用引号包裹
MYSQL_USER=omuser@tellmua100#obhfcgb03uat

# 应用用户密码（请修改为强密码！）
MYSQL_PASSWORD=OceanBase_123#

# 时区设置
TZ=Asia/Shanghai


# ========== Python 应用数据库连接配置 ==========

# 数据库主机地址
# - 宿主机访问: localhost 或 127.0.0.1
# - Docker 容器内访问: mysql（服务名）
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库用户（应用连接使用）
# 与上面的 MYSQL_USER 保持一致
DB_USER=omuser@tellmua100#obhfcgb03uat

# 数据库密码（应用连接使用）
# 与上面的 MYSQL_PASSWORD 保持一致
DB_PASSWORD=OceanBase_123#

# 数据库名称
# 与上面的 MYSQL_DATABASE 保持一致
DB_NAME=omservice

# 字符集
DB_CHARSET=utf8mb4


# ========== 连接池配置 ==========

# 连接池大小
DB_POOL_SIZE=5

# 最大溢出连接数
DB_MAX_OVERFLOW=10

# 连接回收时间（秒）
DB_POOL_RECYCLE=3600

# 是否在使用前 ping 测试连接
DB_POOL_PRE_PING=true

# 是否打印 SQL 语句（开发环境可设为 true）
DB_ECHO_SQL=false


# ========== phpMyAdmin 配置（可选）==========

# phpMyAdmin 访问端口
PHPMYADMIN_PORT=8080

# 上传文件大小限制
UPLOAD_LIMIT=64M


# ==========================================
# 安全提示
# ==========================================
# 1. 生产环境请务必修改所有默认密码
# 2. 使用强密码策略（大小写字母+数字+特殊字符）
# 3. 不要将此文件提交到版本控制系统
# 4. 定期更换密码
# 5. 限制数据库访问来源 IP
# ==========================================
