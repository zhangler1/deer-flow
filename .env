# 应用基础配置
DEBUG=True
APP_ENV=development
AGENT_RECURSION_LIMIT=30

# CORS 配置 - 添加您当前使用的 IP 地址
ALLOWED_ORIGINS=http://frontend:3000,http://192.168.0.106:3000,http://127.0.0.1:3000
# MCP 和 Python REPL 配置
ENABLE_MCP_SERVER_CONFIGURATION=false
ENABLE_PYTHON_REPL=false

# 后端地址，前端浏览器访问，用backend不行
NEXT_PUBLIC_API_URL=http://192.168.0.106:8000/api
# # 搜索引擎配置
# SEARCH_API=tavily
# TAVILY_API_KEY=your_tavily_key_here

#自定义搜索引擎配置（可选）
SEARCH_API=custom_search
CUSTOM_SEARCH_API_URL=http://192.168.0.106:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do
                    #   http://localhost:8010/ELLM.ELLM-OFFICE.V-1.0/querySources.do
CUSTOM_SEARCH_API_KEY=your_custom_search_api_key
CUSTOM_SEARCH_REPOSITORY=okic-dynamicSearch
CUSTOM_SEARCH_CHANNEL_ID=0
# RAG 检索服务配置 - 使用 Milvus Lite (本地开发推荐)
# RAG_PROVIDER=milvus
# MILVUS_URI=./milvus_demo.db
# MILVUS_COLLECTION=documents
# MILVUS_EMBEDDING_PROVIDER=openai
# MILVUS_EMBEDDING_MODEL=text-embedding-ada-002
# MILVUS_EMBEDDING_API_KEY=your_openai_key_here
# MILVUS_AUTO_LOAD_EXAMPLES=true
# MILVUS_TOP_K=10
# MILVUS_CHUNK_SIZE=4000